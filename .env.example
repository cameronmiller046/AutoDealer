# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Postgres. Railway injects this automatically in production.
# DATABASE_URL=postgresql://user:pass@host:5432/railway

# Google Maps Platform — used by the Door Knocking page (/canvass).
# Enable these APIs on the key: Places API (New), Geocoding API, Routes API, Maps JavaScript API.
# Server-side key: Places, Geocoding, Routes. Restrict by IP if you can.
GOOGLE_MAPS_API_KEY=

# Browser key for Maps JavaScript. Falls back to GOOGLE_MAPS_API_KEY if unset.
# Keep this one separate and restrict it by HTTP referrer — it is visible to anyone
# who loads the page. Allowed referrers should include your Railway domain, e.g.
#   https://autodealer-production.up.railway.app/*
GOOGLE_MAPS_BROWSER_KEY=
